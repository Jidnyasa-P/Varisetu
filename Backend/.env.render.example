# VariSetu Backend — environment variables to set on Render
#
# Do NOT commit this file with real values filled in. Set these in the Render
# dashboard: your service -> Environment -> Add Environment Variable.
# This file just documents what to set and why.

# ---------------------------------------------------------------------------
# REQUIRED for the app to run at all
# ---------------------------------------------------------------------------

# Supabase Postgres connection string (free tier). Get this from your Supabase
# project: Settings -> Database -> Connection string -> "Transaction pooler"
# (port 6543) is the right one for a serverless/scale-to-zero-friendly host
# like Render. Must use the asyncpg driver prefix as shown:
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Generate your OWN secret, don't reuse this one -- it was generated once for
# this conversation and should be treated as already-exposed. Generate a new
# one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=g7t5AJJGTAkhQvUQOdVXxgfBPOk0v0SLyUvXOV7CjFt-r3mLr1faPVF-TKjYJxuJ

# ---------------------------------------------------------------------------
# REQUIRED for the real models to actually be called (not the DEMO fallback)
# ---------------------------------------------------------------------------
VISION_PROVIDER=hf_space
HF_SPACE_ID=Saj2005/VariSetu

# ---------------------------------------------------------------------------
# Recommended for a real deployment (not strictly required to boot)
# ---------------------------------------------------------------------------
APP_ENV=production
DEBUG=false
AUTH_REQUIRED=true

# Add your actual Render URL here once you know it (e.g. after first deploy,
# Render assigns https://varisetu-backend-xxxx.onrender.com) -- this line is
# mostly a formality since the frontend is served same-origin from this same
# backend (see app/main.py), but keep it correct for any external API callers.
CORS_ORIGINS=["https://varisetu-backend-xxxx.onrender.com"]

# ---------------------------------------------------------------------------
# Leave as "mock" (the default) unless you have real credentials for these --
# every one of these fails gracefully to simulated/demo data if left unset,
# so the app runs fine without them.
# ---------------------------------------------------------------------------
# SPEECH_PROVIDER=mock          # set to "sarvam" or "groq" + the matching API key for real Marathi ASR
# WEATHER_PROVIDER=mock
# NOTIFICATION_PROVIDER=mock
# VECTOR_PROVIDER=mock          # set to a real Qdrant Cloud free-tier URL if you want persistent vector search
# GOOGLE_MAPS_SERVER_API_KEY=   # only needed for live Routes/Roads API calls

# ---------------------------------------------------------------------------
# Not needed on Render's free tier -- Redis gracefully falls back to an
# in-memory cache if this is unset or unreachable (see app/core/redis.py).
# ---------------------------------------------------------------------------
# REDIS_URL=
